# What NOT to upload to EAS Build.
#
# EAS uses this file INSTEAD OF .gitignore when it exists, so every rule that
# matters for the upload has to be repeated here — dropping node_modules or the
# signing material from this list would start shipping them to the build server.
#
# Without this file the archive was ~198 MB, almost all of it tooling that a
# native build never reads (.claude 254 MB, .git 181 MB on disk).

# ── Dependencies (EAS runs its own install from package-lock.json) ──
node_modules/
jspm_packages/
web_modules/
.pnpm-store
.pnp.*
.yarn/

# ── Version control and editor state ──
.git/
.gitignore
.idea/
.vscode-test/

# ── Claude Code / agent tooling — dev-time only, and by far the biggest win ──
.claude/
.claude-flow/
.agents/
.adal/
skills-lock.json

# ── Docs, specs and design reference (values live in src/lib/theme.ts) ──
specs/
design-system/
DESIGN.md
PRODUCT.md
README.md
AGENTS.md
CLAUDE.md

# ── Tests and test tooling: the native build never runs them ──
e2e/
playwright.config.ts
coverage/
*.lcov
.nyc_output

# ── Secrets and signing material — must never reach a build server ──
# Real values come from EAS env vars / credentials, never from the archive.
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
google-services.json
GoogleService-Info.plist

# ── Native dirs are regenerated by prebuild on the build server ──
/ios/
/android/

# ── Caches, logs and build output ──
.expo/
web-build/
dist/
out/
.cache/
.parcel-cache
.metro-health-check*
.eslintcache
*.tsbuildinfo
*.log
logs/
npm-debug.log*
yarn-error.log*
.kotlin/
.DS_Store
*.orig.*
*.tgz
