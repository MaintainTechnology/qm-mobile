# Copy to .env.local and adjust. .env.local is gitignored; this file is not.
#
# WARNING: everything prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle and can be
# read straight out of a shipped .ipa/.apk. It is configuration, never a secret.
# API keys, provider tokens and signing credentials belong on the QuoteMax backend.

# Base URL of the QuoteMax API this app talks to.
EXPO_PUBLIC_API_URL=https://api.quotemax.com.au

# Clerk publishable key — same Clerk instance as the quotemax.com.au web app.
# Publishable by design (pk_*); the secret key (sk_*) never goes anywhere near this app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Invitation code sent with POST /api/onboard/activate at the end of sign-up.
# The server refuses activation without a valid code; the designed wizard has
# no code field, so mobile builds carry a campaign code here.
EXPO_PUBLIC_ONBOARD_INVITE_CODE=

# RevenueCat public per-platform SDK keys (dashboard → Project Settings →
# API keys → App specific keys). Public by design; purchases are disabled on
# any platform whose key is unset. Native builds only — no effect on web.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxx
