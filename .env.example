# Copy to .env.local and adjust. .env.local is gitignored; this file is not.
#
# WARNING: every EXPO_PUBLIC_* value is inlined into the shipped JavaScript
# bundle and is readable from an .ipa/.apk. Only publishable client
# configuration belongs here. Service-role keys, database passwords, provider
# secrets, signing credentials and Sentry auth tokens belong in their approved
# server/build secret stores and must never be added to this file.

# Base URL of the QuoteMax API this app talks to.
EXPO_PUBLIC_API_URL=https://quotemax.com.au

# Clerk publishable key — same Clerk instance as the QuoteMax web app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Optional direct Supabase experiment/realtime configuration. These are public
# client values only; the service-role key must remain backend-only. Core app
# data continues to use the tenant-scoped QuoteMax API.
EXPO_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=public-anon-or-publishable-key

# RevenueCat public, app-specific SDK keys. Purchases remain disabled on a
# platform whose key is unset.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxx

# Optional public Sentry project DSN. Monitoring remains a no-op when absent.
# SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT are build-service settings,
# not EXPO_PUBLIC app values.
EXPO_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0000000
