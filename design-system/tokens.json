{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "QuoteMax Mobile",
  "sourceOfTruth": "../DESIGN.md",
  "color": {
    "dark": {
      "inkDeep": "#16120F",
      "ink": "#1E1813",
      "inkCard": "#2B2422",
      "inkLine": "#3A322C",
      "ctlLine": "#7A6E5E",
      "accent": "#FFC400",
      "accentPress": "#E6AC00",
      "accentSoft": "#FFD23D",
      "accentInk": "#1C1812",
      "textPri": "#F6F1EA",
      "textSec": "#C3B8AC",
      "textDim": "#A2968A",
      "edgeGlow": "#6E6354",
      "edgeDeep": "#4A4136",
      "success": "#15803D",
      "successBright": "#34D27B",
      "warning": "#B45309",
      "warningBright": "#F59E0B",
      "danger": "#B91C1C",
      "dangerBright": "#F0816B",
      "logoBody": "#FFFFFF",
      "logoNotch": "#E3C13C"
    },
    "light": {
      "inkDeep": "#FAF8F4",
      "ink": "#F3EEE7",
      "inkCard": "#FFFFFF",
      "inkLine": "#CFC2B0",
      "ctlLine": "#8A7D6A",
      "accent": "#FFC400",
      "accentPress": "#E6AC00",
      "accentSoft": "#2B2422",
      "accentInk": "#2B2422",
      "textPri": "#241E1B",
      "textSec": "#5E544E",
      "textDim": "#6E645C",
      "edgeGlow": "#8A7D6A",
      "edgeDeep": "#6E6354",
      "success": "#15803D",
      "successBright": "#15803D",
      "warning": "#B45309",
      "warningBright": "#B45309",
      "danger": "#B91C1C",
      "dangerBright": "#B91C1C",
      "logoBody": "#16120F",
      "logoNotch": "#E3C13C"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Manrope",
      "mono": "JetBrains Mono"
    },
    "weights": {
      "sans": [400, 500, 600, 700, 800],
      "mono": [400, 600, 700]
    },
    "scale": {
      "display": { "size": 34, "lineHeight": 36, "weight": 800, "letterSpacing": -1.36, "transform": "uppercase", "family": "sans" },
      "headline": { "size": 26, "lineHeight": 28, "weight": 800, "letterSpacing": -1.04, "transform": "uppercase", "family": "sans" },
      "title": { "size": 18, "lineHeight": 24, "weight": 700, "letterSpacing": -0.36, "family": "sans" },
      "body": { "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": 0, "family": "sans" },
      "bodySm": { "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": 0, "family": "sans" },
      "label": { "size": 12, "lineHeight": 16, "weight": 600, "letterSpacing": 2.16, "transform": "uppercase", "family": "mono" },
      "price": { "size": 28, "lineHeight": 32, "weight": 700, "letterSpacing": 0, "family": "mono", "fontVariant": "tabular-nums" }
    }
  },
  "radius": {
    "card": 14,
    "control": 9,
    "chip": 6,
    "sheet": 16,
    "pill": 9999
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "12": 48, "16": 64 },
  "touch": { "minimum": 48, "listRow": 56, "primaryCta": 56 },
  "motion": {
    "duration": { "fast": 120, "base": 180, "slow": 240 },
    "easing": {
      "out": [0.23, 1, 0.32, 1],
      "inOut": [0.77, 0, 0.175, 1]
    },
    "pressScale": 0.97
  },
  "depth": {
    "rule": "borders-not-shadows",
    "hairlineWidth": 1,
    "litEdge": "inset 0 1 0 rgba(255,255,255,0.06)",
    "litEdgeLight": "0 1 2 rgba(43,36,34,0.06)",
    "menuShadow": "0 16 40 -12 rgba(11,9,7,0.55)",
    "overlayShadow": "0 24 60 -12 rgba(11,9,7,0.7)",
    "noiseOpacity": { "dark": 0.045, "light": 0.03 }
  }
}
