{
  "expo": {
    "name": "QuoteMax",
    "slug": "quotemax-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quotemax",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#FFC400",
    "ios": {
      "bundleIdentifier": "au.com.quotemax.mobile",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:quotemax.com.au",
        "applinks:www.quotemax.com.au"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "au.com.quotemax.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#16120F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "quotemax.com.au",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "www.quotemax.com.au",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16120F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": "QuoteMax uses the camera to take site photos to attach to your quotes and videos.",
          "photosPermission": "QuoteMax uses your photo library to attach existing site photos to your quotes and videos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "QuoteMax uses Face ID to unlock the app quickly."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FFC400"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ff37186-cb0b-4c61-88a8-d4ddb6d756ce"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/1ff37186-cb0b-4c61-88a8-d4ddb6d756ce"
    }
  }
}
